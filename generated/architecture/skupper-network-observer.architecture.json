  "cards": [
    {
      "dot": "cyan",
      "title": "Collection pipeline",
      "items": [
        "Discovery listens for CONTROLLER and ROUTER event-source announcements over the AMQP session",
        "Per-source EventSource Clients subscribe to .flows and .heartbeats addresses and route records into the store",
        "The Collector's work-queue drives managers: processManager, addressManager, pairManager, and metricsAdaptor"
      ]
    },
    {
      "dot": "emerald",
      "title": "In-memory model",
      "items": [
        "Vanflow Store holds vanflow records (Site, Router, Link, Listener, Connector, Process, Flow…) with configurable TTL",
        "Topology Graph is a DAG tracking parent-child and peer relations (Site → Router → Listener/Connector → Process)",
        "Record cleanup runs every 10 s and purges terminated or TTL-expired records"
      ]
    },
    {
      "dot": "rose",
      "title": "Serving layer",
      "items": [
        "REST API (v2alpha1) is code-generated from an OpenAPI spec and served on :8080 (optional TLS)",
        "A separate /metrics endpoint (Prometheus) can be split to a dedicated listen address via --listen-metrics",
        "The optional Web Console SPA is proxied through the API server with a Prometheus query proxy for charts"
      ]
    }
  ]
}
